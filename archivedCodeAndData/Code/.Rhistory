library(dplyr)
library(ggplot2)
library(popbio)
# calculate the expected increase in fawn survivorship as a function of
# number of added roads
get_f_from_road_number <- function(road_number) {
return(road_number * 0.0016)
}
# calculate the expected decrease in yearling survivorship as a function of
# number of added roads
get_m_from_road_number <- function(road_number) {
return(road_number * 0.0024)
}
# code to create the base PPM (R = 0)
PPM_deer <- matrix(0, 4, 4)
PPM_deer[1, 2] <- 0.51
PPM_deer[1, 3] <- 0.75
PPM_deer[1, 4] <- 0.15
PPM_deer[2, 1] <- 0.59
PPM_deer[3, 2] <- 0.64
PPM_deer[3, 3] <- 0.60
PPM_deer[4, 3] <- 0.04
PPM_deer[4, 4] <- 0.20
# perform an eigen-analysis
eigen_analysis <- popbio::eigen.analysis(PPM_deer)
stable_age_distribution <- eigen_analysis$stable.stage
elasticity_matrix <- eigen_analysis$elasticities
elasticity_matrix
