# Figure 4: residual vs. fitted + normal QQplot - final model (model3)
residualPlot_final <- ggplot(data.frame(fitted = fitted(model3),
residuals = rstandard(model3)),
aes(x = fitted, y = residuals)) +
geom_point(alpha = 0.75) + geom_smooth(method = "loess", se = FALSE) +
geom_hline(yintercept = 0, linetype = "dashed") + theme_classic() +
labs(title = "A: Residuals vs Fitted of Final Model",
x = "Fitted Values", y = "Standardized Residuals")
QQplot_final <- ggplot(data = data.frame(residuals = rstandard(model3)),
aes(sample = residuals)) + stat_qq() + stat_qq_line() +
theme_classic() + labs(title = "B: Normal Q-Q Plot of Final Model",
x = "Theoretical Quantiles", y = "Sample Quantiles")
figure4_plot <- (residualPlot_final / QQplot_final)
figure4_plot
