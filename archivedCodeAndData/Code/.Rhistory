# copy data
Y <- c(0, 2, 0.6, 1.1, 1.8)
X1 <- c(9, 1, 1.2, 1.4, -1)
X2 <- c(-0.9, 0.7, 0.1, -0.7, 0.4)
# get necessary objects
n <- length(Y)
p <- 2
X <- X <- cbind(1, X1, X2)
Xt <- t(X)
XtX_inv <- solve(Xt%*%X)
# compute estimastes
beta_hat <- XtX_inv %*% Xt %*% Y
Y_hat <- X %*% beta_hat
e_hat <- Y - Y_hat
RSS <- sum(e_hat) ** 2
sigma2_hat <- (1 / (n - p - 1)) * RSS
beta_hat
sigma2_hat
RSS
Y_hat
Y
e_hat
sum(e_hat)
Colsums(e_hat)
colSums(e_hat)
sum(e_hat)
